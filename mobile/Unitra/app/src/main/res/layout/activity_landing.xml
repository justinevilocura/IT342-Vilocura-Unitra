<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp"
    tools:context=".LandingActivity">

    <TextView
        android:id="@+id/pillBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:background="@drawable/pill_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Campus Marketplace &amp; Community Hub"
        android:textColor="@color/primary_black"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/heroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Unite. Share.\nGrow Together."
        android:textColor="@color/primary_black"
        android:textSize="48sp"
        android:textStyle="bold"
        android:lineHeight="52sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pillBadge" />

    <TextView
        android:id="@+id/heroSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Unitra connects student entrepreneurs and consumers to share resources, knowledge, and opportunities — accelerating growth through collaboration."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:lineHeight="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroTitle" />

    <Button
        android:id="@+id/btnJoin"
        style="@style/Button.Outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Join the Network"
        app:icon="@drawable/ic_arrow_right"
        app:iconGravity="textEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroSubtitle" />

    <Button
        android:id="@+id/btnLearnMore"
        style="@style/Button.Outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Learn More"
        app:layout_constraintBottom_toBottomOf="@id/btnJoin"
        app:layout_constraintStart_toEndOf="@id/btnJoin"
        app:layout_constraintTop_toTopOf="@id/btnJoin" />

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="40dp"
        android:scaleType="centerInside"
        android:src="@drawable/wireframe_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnJoin" />

</androidx.constraintlayout.widget.ConstraintLayout>
