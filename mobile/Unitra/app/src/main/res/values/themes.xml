<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Unitra" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/primary_bg</item>
        <item name="android:statusBarColor">@color/primary_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.Unitra" parent="Base.Theme.Unitra" />

    <!-- Custom Button Styles -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/accent_primary</item>
        <item name="android:textColor">@color/primary_bg</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Unitra.PillComponent</item>
    </style>

    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/surface_border</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Unitra.PillComponent</item>
    </style>
    
    <style name="ShapeAppearance.Unitra.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Unitra.PillComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">999dp</item>
    </style>

    <!-- Legacy aliases -->
    <style name="Button.Accent" parent="Button.Primary" />
</resources>
