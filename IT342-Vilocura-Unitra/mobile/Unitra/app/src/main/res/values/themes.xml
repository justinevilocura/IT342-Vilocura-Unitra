<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Unitra" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_black</item>
        <item name="colorSecondary">@color/accent_brown</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Unitra" parent="Base.Theme.Unitra" />

    <!-- Custom Button Styles -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary_black</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Unitra.MediumComponent</item>
    </style>

    <style name="Button.Accent" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/accent_brown</item>
        <item name="android:textColor">@color/black</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Unitra.MediumComponent</item>
    </style>

    <style name="Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/border_color</item>
        <item name="android:textColor">@color/primary_black</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Unitra.PillComponent</item>
    </style>
    
    <style name="ShapeAppearance.Unitra.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Unitra.PillComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

</resources>